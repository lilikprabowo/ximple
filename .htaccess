# Disable directory browsing
Options -Indexes

# Block direct access to sensitive config, backup, repo, and Docker files
<FilesMatch "(^\.env|^\.git|docker-compose\.ya?ml$|Dockerfile$|composer\.(json|lock)$|ximple_bot$|\.(sql|log|bak|old|sh|md|ini|yml|yaml)$)">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Modern HTTP Security Headers (RISE 4.x Hardening)
<IfModule mod_headers.c>
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set X-XSS-Protection "1; mode=block"
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
    Header always unset X-Powered-By
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Block direct HTTP access to internal folders
    RewriteRule ^(\.git|application|system|mcgg-assistant)(/|$) - [F,L]

    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.*)$ index.php?/$1 [L,QSA]
</IfModule>
